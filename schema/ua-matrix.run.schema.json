              "$ref": "#/$defs/nonemptyString"
            },
            "WSL_DISTRO_NAME": {
              "$ref": "#/$defs/nonemptyString"
            }
          },
          "patternProperties": {
            "^(?:TERM.*|WT_.*|WSL_.*)$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "tty": {
          "const": [
            true,
            true,
