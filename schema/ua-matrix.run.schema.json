                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/collectedProfile"
                    },
                    {
                      "properties": {
                        "launch_method": {
                          "const": "herdr-pty"
                        },
                        "application": {
                          "properties": {
                            "version": {
                              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
