    },
    "cliNativeUserAgent": {
      "type": "string",
      "pattern": "^codex-tui/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) [^()\\u0000-\\u001f\\u007f]+ \\(codex-tui; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "execNativeUserAgent": {
      "type": "string",
      "pattern": "^codex_exec/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) [^()\\u0000-\\u001f\\u007f]+ \\(codex_exec; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "nativeClients": {
      "type": "object",
      "required": [
        "CLI",
        "Exec"
      ],
      "properties": {
        "CLI": {
          "type": "object",
          "required": [
            "user_agent",
            "method",
            "http_capture"
          ],
          "properties": {
            "user_agent": {
              "$ref": "#/$defs/cliNativeUserAgent"
            },
            "method": {
              "const": "http-capture"
            },
            "http_capture": {
              "type": "object",
              "required": [
                "user_agent",
                "originator"
              ],
              "properties": {
                "user_agent": {
                  "$ref": "#/$defs/cliNativeUserAgent"
                },
                "originator": {
                  "const": "codex-tui"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "Exec": {
          "type": "object",
          "required": [
            "user_agent",
            "method",
            "http_capture"
          ],
          "properties": {
            "user_agent": {
              "$ref": "#/$defs/execNativeUserAgent"
            },
            "method": {
              "const": "http-capture"
            },
            "http_capture": {
              "type": "object",
              "required": [
                "user_agent",
                "originator"
              ],
              "properties": {
                "user_agent": {
                  "$ref": "#/$defs/execNativeUserAgent"
                },
                "originator": {
                  "const": "codex_exec"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
