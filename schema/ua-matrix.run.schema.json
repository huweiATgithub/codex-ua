        },
        "terminal": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^(?:TERM.*|WT_.*|HERDR_.*)$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "tty": {
          "const": [
            true,
            true,
            true
