    "collectedProfile": {
      "type": "object",
      "required": [
        "status",
        "application",
        "launch_method",
        "terminal",
        "tty",
        "clients"
      ],
      "properties": {
        "status": {
          "const": "collected"
        },
        "application": {
          "type": "object",
          "required": [
            "version",
            "source_url"
