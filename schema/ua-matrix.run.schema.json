              "linux-ubuntu-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-ubuntu-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-debian-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-debian-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-fedora-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-fedora-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-alpine-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-alpine-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "macos-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "macos-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "windows-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "windows-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              }
            }
          }
