{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex CLI user-agent collection run",
  "description": "One complete collection for an official stable Codex CLI version. Cross-field version and captured-header equality are checked by the collector.",
  "type": "object",
  "required": [
    "schema_version",
    "codex_version",
    "upstream_release",
    "collector",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3,
        4
      ],
      "type": "integer"
    },
    "codex_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "upstream_release": {
      "type": "string",
      "pattern": "^https://github\\.com/openai/codex/releases/tag/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "collector": {
      "type": "object",
      "required": [
        "commit",
        "run_url"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/actions/runs/[1-9][0-9]*(?:/attempts/[1-9][0-9]*)?$"
        }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "required": [
        "linux-ubuntu-x64",
        "linux-ubuntu-arm64",
        "linux-debian-x64",
        "linux-debian-arm64",
        "linux-fedora-x64",
        "linux-fedora-arm64",
        "linux-alpine-x64",
        "linux-alpine-arm64",
        "macos-x64",
        "macos-arm64",
        "windows-x64",
        "windows-arm64"
      ],
      "properties": {
        "linux-ubuntu-x64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "x86_64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-x86_64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[xX]86_64|[aA][mM][dD]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "ubuntu"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "linux-ubuntu-arm64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "aarch64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-aarch64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[aA][aA][rR][cC][hH]64|[aA][rR][mM]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "ubuntu"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "linux-debian-x64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "x86_64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-x86_64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[xX]86_64|[aA][mM][dD]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "debian"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "linux-debian-arm64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "aarch64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-aarch64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[aA][aA][rR][cC][hH]64|[aA][rR][mM]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "debian"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "linux-fedora-x64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "x86_64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-x86_64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[xX]86_64|[aA][mM][dD]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "fedora"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "linux-fedora-arm64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "aarch64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-aarch64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[aA][aA][rR][cC][hH]64|[aA][rR][mM]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "fedora"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "linux-alpine-x64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "x86_64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-x86_64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[xX]86_64|[aA][mM][dD]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "alpine"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "linux-alpine-arm64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "aarch64-unknown-linux-musl"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-aarch64-unknown-linux-musl\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Linux"
                    },
                    "machine": {
                      "pattern": "^(?:[aA][aA][rR][cC][hH]64|[aA][rR][mM]64)$"
                    },
                    "distribution": {
                      "properties": {
                        "id": {
                          "const": "alpine"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            }
          ]
        },
        "macos-x64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "x86_64-apple-darwin"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-x86_64-apple-darwin\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Darwin"
                    },
                    "machine": {
                      "pattern": "^(?:[xX]86_64|[aA][mM][dD]64)$"
                    },
                    "distribution": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          ]
        },
        "macos-arm64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "aarch64-apple-darwin"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-aarch64-apple-darwin\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Darwin"
                    },
                    "machine": {
                      "pattern": "^(?:[aA][aA][rR][cC][hH]64|[aA][rR][mM]64)$"
                    },
                    "distribution": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          ]
        },
        "windows-x64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "x86_64-pc-windows-msvc"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-x86_64-pc-windows-msvc\\.exe\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Windows"
                    },
                    "machine": {
                      "pattern": "^(?:[xX]86_64|[aA][mM][dD]64)$"
                    },
                    "distribution": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          ]
        },
        "windows-arm64": {
          "allOf": [
            {
              "$ref": "#/$defs/platform"
            },
            {
              "properties": {
                "target": {
                  "const": "aarch64-pc-windows-msvc"
                },
                "source_url": {
                  "pattern": "^https://github\\.com/openai/codex/releases/download/rust-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/codex-aarch64-pc-windows-msvc\\.exe\\.tar\\.gz$"
                },
                "os": {
                  "properties": {
                    "system": {
                      "const": "Windows"
                    },
                    "machine": {
                      "pattern": "^(?:[aA][aA][rR][cC][hH]64|[aA][rR][mM]64)$"
                    },
                    "distribution": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "terminal_releases": {
      "type": "object",
      "required": [
        "WindowsTerminal",
        "vscode",
        "herdr"
      ],
      "properties": {
        "WindowsTerminal": {
          "type": "object",
          "required": [
            "version",
            "source_url",
            "assets"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){3}$"
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://github\\.com/microsoft/terminal/releases/"
            },
            "assets": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "windows-x64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/microsoft/terminal/releases/download/"
                },
                "windows-arm64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/microsoft/terminal/releases/download/"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "vscode": {
          "type": "object",
          "required": [
            "version",
            "source_url",
            "assets"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://code\\.visualstudio\\.com/updates/"
            },
            "assets": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "linux-x64": {
                  "type": "string",
                  "pattern": "^https://update\\.code\\.visualstudio\\.com/"
                },
                "linux-arm64": {
                  "type": "string",
                  "pattern": "^https://update\\.code\\.visualstudio\\.com/"
                },
                "macos-x64": {
                  "type": "string",
                  "pattern": "^https://update\\.code\\.visualstudio\\.com/"
                },
                "macos-arm64": {
                  "type": "string",
                  "pattern": "^https://update\\.code\\.visualstudio\\.com/"
                },
                "windows-x64": {
                  "type": "string",
                  "pattern": "^https://update\\.code\\.visualstudio\\.com/"
                },
                "windows-arm64": {
                  "type": "string",
                  "pattern": "^https://update\\.code\\.visualstudio\\.com/"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "herdr": {
          "type": "object",
          "required": [
            "version",
            "source_url",
            "assets"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://github\\.com/herdrdev/herdr/releases/"
            },
            "assets": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "linux-x64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/herdrdev/herdr/releases/download/"
                },
                "linux-arm64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/herdrdev/herdr/releases/download/"
                },
                "macos-x64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/herdrdev/herdr/releases/download/"
                },
                "macos-arm64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/herdrdev/herdr/releases/download/"
                },
                "windows-x64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/herdrdev/herdr/releases/download/"
                },
                "windows-arm64": {
                  "type": "string",
                  "pattern": "^https://github\\.com/herdrdev/herdr/releases/download/"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "cliUserAgent": {
      "type": "string",
      "pattern": "^codex-tui/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) xterm-256color \\(codex-tui; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "execUserAgent": {
      "type": "string",
      "pattern": "^codex_exec/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) xterm-256color \\(codex_exec; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "legacyPlatform": {
      "type": "object",
      "required": [
        "target",
        "source_url",
        "collected_at",
        "os",
        "runner",
        "terminal",
        "clients"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source_url": {
          "$ref": "#/$defs/nonemptyString"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
        },
        "os": {
          "type": "object",
          "required": [
            "system",
            "release",
            "version",
            "machine",
            "distribution"
          ],
          "properties": {
            "system": {
              "$ref": "#/$defs/nonemptyString"
            },
            "release": {
              "$ref": "#/$defs/nonemptyString"
            },
            "version": {
              "$ref": "#/$defs/nonemptyString"
            },
            "machine": {
              "$ref": "#/$defs/nonemptyString"
            },
            "distribution": {
              "oneOf": [
                {
                  "$ref": "#/$defs/distribution"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "runner": {
          "type": "object",
          "required": [
            "name",
            "image",
            "image_version",
            "container_image"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonemptyString"
            },
            "image": {
              "$ref": "#/$defs/nonemptyString"
            },
            "image_version": {
              "$ref": "#/$defs/nonemptyString"
            },
            "container_image": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nonemptyString"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "terminal": {
          "type": "object",
          "required": [
            "TERM"
          ],
          "properties": {
            "TERM": {
              "const": "xterm-256color"
            }
          },
          "additionalProperties": false
        },
        "clients": {
          "type": "object",
          "required": [
            "CLI",
            "Exec"
          ],
          "properties": {
            "CLI": {
              "type": "object",
              "required": [
                "user_agent",
                "method",
                "http_capture"
              ],
              "properties": {
                "user_agent": {
                  "$ref": "#/$defs/cliUserAgent"
                },
                "method": {
                  "const": "http-capture"
                },
                "http_capture": {
                  "type": "object",
                  "required": [
                    "user_agent",
                    "originator"
                  ],
                  "properties": {
                    "user_agent": {
                      "$ref": "#/$defs/cliUserAgent"
                    },
                    "originator": {
                      "const": "codex-tui"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "Exec": {
              "type": "object",
              "required": [
                "user_agent",
                "method",
                "http_capture"
              ],
              "properties": {
                "user_agent": {
                  "$ref": "#/$defs/execUserAgent"
                },
                "method": {
                  "const": "http-capture"
                },
                "http_capture": {
                  "type": "object",
                  "required": [
                    "user_agent",
                    "originator"
                  ],
                  "properties": {
                    "user_agent": {
                      "$ref": "#/$defs/execUserAgent"
                    },
                    "originator": {
                      "const": "codex_exec"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "profiles": {
          "type": "object",
          "required": [
            "WindowsTerminal",
            "vscode",
            "herdr"
          ],
          "properties": {
            "WindowsTerminal": {
              "oneOf": [
                {
                  "$ref": "#/$defs/unsupportedProfile"
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/collectedProfile"
                    },
                    {
                      "properties": {
                        "launch_method": {
                          "const": "windows-terminal"
                        },
                        "application": {
                          "properties": {
                            "version": {
                              "pattern": "^[0-9]+(?:\\.[0-9]+){3}$"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "vscode": {
              "oneOf": [
                {
                  "$ref": "#/$defs/unsupportedProfile"
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/collectedProfile"
                    },
                    {
                      "properties": {
                        "launch_method": {
                          "const": "vscode-integrated-terminal"
                        },
                        "application": {
                          "properties": {
                            "version": {
                              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "herdr": {
