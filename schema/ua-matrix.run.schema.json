                            "properties": {
                              "runtime": {
                                "properties": {
                                  "os": {
                                    "properties": {
                                      "machine": {
                                        "pattern": "^(?:[Aa][Aa][Rr][Cc][Hh]64|[Aa][Rr][Mm]64)$"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "platforms": {
            "additionalProperties": {
              "$ref": "#/$defs/legacyPlatform"
            }
          }
        }
