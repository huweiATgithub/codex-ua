      "properties": {
        "status": {
          "const": "collected"
        },
        "application": {
          "type": "object",
          "required": [
            "version",
            "source_url"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){3}$"
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "additionalProperties": false
        },
        "launch_method": {
          "const": "windows-terminal-wsl"
        },
        "terminal": {
          "type": "object",
          "required": [
            "WT_SESSION",
