    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 4
          }
        }
      },
      "then": {
        "properties": {
          "platforms": {
            "additionalProperties": {
              "$ref": "#/$defs/profilePlatform"
            },
            "allOf": [
              {
                "patternProperties": {
                  "^linux-ubuntu-": {
                    "properties": {
                      "profiles": {
                        "properties": {
                          "WindowsTerminal": {
                            "$ref": "#/$defs/wslProfile"
                          }
                        }
                      }
                    }
                  },
                  "^(?:linux-(?:debian|fedora|alpine)|macos|windows)-": {
                    "properties": {
                      "profiles": {
                        "properties": {
                          "WindowsTerminal": {
                            "$ref": "#/$defs/legacyPlatform/properties/profiles/properties/WindowsTerminal"
                          }
                        }
                      }
                    }
                  },
                  "^linux-ubuntu-x64$": {
                    "properties": {
                      "profiles": {
                        "properties": {
                          "WindowsTerminal": {
                            "properties": {
                              "runtime": {
                                "properties": {
                                  "os": {
                                    "properties": {
                                      "machine": {
                                        "pattern": "^(?:[Xx]86_64|[Aa][Mm][Dd]64)$"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
