{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex CLI user-agent matrix",
  "description": "User-agent strings for each platform and client mode, derived from one complete collection run.",
  "type": "object",
  "required": [
    "schema_version",
    "codex_version",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "codex_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "platforms": {
      "type": "object",
      "required": [
        "linux-ubuntu-x64",
        "linux-ubuntu-arm64",
        "linux-debian-x64",
        "linux-debian-arm64",
        "linux-fedora-x64",
        "linux-fedora-arm64",
        "linux-alpine-x64",
        "linux-alpine-arm64",
        "macos-x64",
        "macos-arm64",
        "windows-x64",
        "windows-arm64"
      ],
      "properties": {
        "linux-ubuntu-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-ubuntu-arm64": {
          "$ref": "#/$defs/clients"
        },
        "linux-debian-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-debian-arm64": {
          "$ref": "#/$defs/clients"
        },
        "linux-fedora-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-fedora-arm64": {
          "$ref": "#/$defs/clients"
        },
        "linux-alpine-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-alpine-arm64": {
          "$ref": "#/$defs/clients"
        },
        "macos-x64": {
          "$ref": "#/$defs/clients"
        },
        "macos-arm64": {
          "$ref": "#/$defs/clients"
        },
        "windows-x64": {
          "$ref": "#/$defs/clients"
        },
        "windows-arm64": {
          "$ref": "#/$defs/clients"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cliUserAgent": {
      "type": "string",
      "pattern": "^codex-tui/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) xterm-256color \\(codex-tui; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "execUserAgent": {
      "type": "string",
      "pattern": "^codex_exec/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) xterm-256color \\(codex_exec; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "clients": {
      "type": "object",
      "required": [
        "CLI",
        "Exec"
      ],
      "properties": {
        "CLI": {
          "$ref": "#/$defs/cliUserAgent"
        },
        "Exec": {
          "$ref": "#/$defs/execUserAgent"
        }
      },
      "additionalProperties": false
    }
  }
}
