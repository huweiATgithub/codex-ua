{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex CLI user-agent matrix",
  "description": "User-agent strings for each platform and client mode, derived from one complete collection run.",
  "type": "object",
  "required": [
    "schema_version",
    "codex_version",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3
      ],
      "type": "integer"
    },
    "codex_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "platforms": {
      "type": "object",
      "required": [
        "linux-ubuntu-x64",
        "linux-ubuntu-arm64",
        "linux-debian-x64",
        "linux-debian-arm64",
        "linux-fedora-x64",
        "linux-fedora-arm64",
        "linux-alpine-x64",
        "linux-alpine-arm64",
        "macos-x64",
        "macos-arm64",
        "windows-x64",
        "windows-arm64"
      ],
      "properties": {
        "linux-ubuntu-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-ubuntu-arm64": {
          "$ref": "#/$defs/clients"
        },
        "linux-debian-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-debian-arm64": {
          "$ref": "#/$defs/clients"
        },
        "linux-fedora-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-fedora-arm64": {
          "$ref": "#/$defs/clients"
        },
        "linux-alpine-x64": {
          "$ref": "#/$defs/clients"
        },
        "linux-alpine-arm64": {
          "$ref": "#/$defs/clients"
        },
        "macos-x64": {
          "$ref": "#/$defs/clients"
        },
        "macos-arm64": {
          "$ref": "#/$defs/clients"
        },
        "windows-x64": {
          "$ref": "#/$defs/clients"
        },
        "windows-arm64": {
          "$ref": "#/$defs/clients"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cliUserAgent": {
      "type": "string",
      "pattern": "^codex-tui/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) xterm-256color \\(codex-tui; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "execUserAgent": {
      "type": "string",
      "pattern": "^codex_exec/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) xterm-256color \\(codex_exec; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "legacyClients": {
      "type": "object",
      "required": [
        "CLI",
        "Exec"
      ],
      "properties": {
        "CLI": {
          "$ref": "#/$defs/cliUserAgent"
        },
        "Exec": {
          "$ref": "#/$defs/execUserAgent"
        },
        "profiles": {
          "type": "object",
          "required": [
            "WindowsTerminal",
            "vscode",
            "herdr"
          ],
          "properties": {
            "WindowsTerminal": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nativeClients"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vscode": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nativeClients"
                },
                {
                  "type": "null"
                }
              ]
            },
            "herdr": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nativeClients"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cliNativeUserAgent": {
      "type": "string",
      "pattern": "^codex-tui/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) [^()\\u0000-\\u001f\\u007f]+ \\(codex-tui; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "execNativeUserAgent": {
      "type": "string",
      "pattern": "^codex_exec/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*) \\([^;()\\u0000-\\u001f\\u007f]+; [^;()\\u0000-\\u001f\\u007f]+\\) [^()\\u0000-\\u001f\\u007f]+ \\(codex_exec; (?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\)$"
    },
    "nativeClients": {
      "type": "object",
      "required": [
        "CLI",
        "Exec"
      ],
      "properties": {
        "CLI": {
          "$ref": "#/$defs/cliNativeUserAgent"
        },
        "Exec": {
          "$ref": "#/$defs/execNativeUserAgent"
        }
      },
      "additionalProperties": false
    },
    "clients": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyClients"
        },
        {
          "$ref": "#/$defs/profilePlatform"
        }
      ]
    },
    "profilePlatform": {
      "type": "object",
      "required": [
        "profiles"
      ],
      "properties": {
        "profiles": {
          "type": "object",
          "required": [
            "xterm-256color",
            "WindowsTerminal",
            "vscode",
            "herdr"
          ],
          "properties": {
            "xterm-256color": {
              "$ref": "#/$defs/nativeClients"
            },
            "WindowsTerminal": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nativeClients"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vscode": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nativeClients"
                },
                {
                  "type": "null"
                }
              ]
            },
            "herdr": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nativeClients"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              2,
              3
            ]
          }
        }
      },
      "then": {
        "properties": {
          "platforms": {
            "properties": {
              "linux-ubuntu-x64": {
                "required": [
                  "profiles"
                ]
              },
              "linux-ubuntu-arm64": {
                "required": [
                  "profiles"
                ]
              },
              "linux-debian-x64": {
                "required": [
                  "profiles"
                ]
              },
              "linux-debian-arm64": {
                "required": [
                  "profiles"
                ]
              },
              "linux-fedora-x64": {
                "required": [
                  "profiles"
                ]
              },
              "linux-fedora-arm64": {
                "required": [
                  "profiles"
                ]
              },
              "linux-alpine-x64": {
                "required": [
                  "profiles"
                ]
              },
              "linux-alpine-arm64": {
                "required": [
                  "profiles"
                ]
              },
              "macos-x64": {
                "required": [
                  "profiles"
                ]
              },
              "macos-arm64": {
                "required": [
                  "profiles"
                ]
              },
              "windows-x64": {
                "required": [
                  "profiles"
                ]
              },
              "windows-arm64": {
                "required": [
                  "profiles"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "platforms": {
            "properties": {
              "linux-ubuntu-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-ubuntu-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-debian-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-debian-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-fedora-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-fedora-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-alpine-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "linux-alpine-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "macos-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "macos-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "windows-x64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              },
              "windows-arm64": {
                "not": {
                  "required": [
                    "profiles"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "platforms": {
            "additionalProperties": {
              "$ref": "#/$defs/profilePlatform"
            },
            "allOf": [
              {
                "patternProperties": {
                  "^linux-ubuntu-": {
                    "properties": {
                      "profiles": {
                        "properties": {
                          "WindowsTerminal": {
                            "$ref": "#/$defs/nativeClients"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "platforms": {
            "additionalProperties": {
              "$ref": "#/$defs/legacyClients"
            }
          }
        }
      }
    }
  ]
}
